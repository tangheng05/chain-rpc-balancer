[Unit]
Description=chain-rpc-balancer health agent
After=network-online.target
Wants=network-online.target
Before=haproxy.service

[Service]
ExecStart=/usr/bin/node /opt/chain-rpc-balancer/src/agent.js /opt/chain-rpc-balancer/nodes.json
Restart=always
RestartSec=1
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
